// Root tsconfig to set the settings and power editor support for all TS files
{
    // To update the compilation target, install a different version of @tsconfig/node... and reference it here
    // https://github.com/tsconfig/bases#node-20-tsconfigjson
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        // do not compile anything, this file is just to configure type checking
        // the compilation is configured in tsconfig.build.json
        "noEmit": true,

        // check JS files, but do not compile them => tsconfig.build.json
        "allowJs": true,
        "checkJs": true,

        "noEmitOnError": true,
        "outDir": "./build/",
        "removeComments": false,

        // This is necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,

        // Declared explicitly because @tsconfig/node22 22.0.6 sets "types" to
        // ["node"] itself, which switches off TypeScript's default of including
        // every @types package it can find. Before that this project relied on
        // that default to pick up mocha and chai transitively through
        // @iobroker/testing, so the bump turned every `describe` and `expect`
        // in the tests into TS2593 -- 39 of them. Listing them here, with the
        // packages added as real devDependencies, means a future change to the
        // base config or to npm's hoisting cannot take them away again.
        "types": ["node", "iobroker", "mocha", "chai"],

        // If you want to disable the stricter type checks (not recommended), uncomment the following line
        // "strict": false,
        // And enable some of those features for more fine-grained control
        // "strictNullChecks": true,
        // "strictPropertyInitialization": true,
        // "strictBindCallApply": true,
        // "noImplicitAny": true,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        // Uncomment this if you want the old behavior of catch variables being `any`
        // "useUnknownInCatchVariables": false,

        "sourceMap": true,
        "inlineSourceMap": false
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "build/**",
        "node_modules/**",
        "widgets/**"
    ]
}